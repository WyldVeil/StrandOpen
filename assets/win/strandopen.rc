// Strand Open's Windows resources: the icon and the manifest (UTF-8 code page)
1 ICON "strandopen.ico"
1 24 "strandopen.manifest"
1 VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Strand Open genome explorer"
      VALUE "FileVersion", "1.2.0"
      VALUE "ProductName", "Strand Open"
      VALUE "ProductVersion", "1.2.0"
      VALUE "LegalCopyright", "MIT licence"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
